# Template for LOCAL development with docker-compose. Copy to .env.dev:
#
#     cp .env.dev.example .env.dev
#     docker compose --env-file .env.dev up --build
#
# Every name here is DEV_-prefixed on purpose. docker-compose.yml refuses to
# reference a production variable name, because compose would otherwise resolve
# it from the .env in this directory — which holds live credentials — and start a
# second bot against production.
#
# .env.dev is gitignored. Do not put real production values in it.

# REQUIRED. A throwaway bot from @BotFather, never the production one: two
# pollers on the same token fight over getUpdates and neither works properly.
# Compose fails with an explanation if this is unset.
DEV_BOT_TOKEN=

# Optional. A private channel to receive detection alerts while testing.
DEV_LOG_CHANNEL_ID=

# Optional. Only needed to exercise profile-change events and /sweep, which need
# MTProto. Use a THROWAWAY Telegram account — a session string is a full
# credential for whatever account generated it. Leave blank to run Bot-API-only;
# the watcher stays disabled and says so at startup.
DEV_PYROGRAM_API_ID=
DEV_PYROGRAM_API_HASH=
DEV_PYROGRAM_SESSION=

# Optional. Comma-separated group IDs whose manual bans may propagate to other
# groups. Leave blank locally — empty means propagation is off, which is the
# right default for a dev container.
DEV_BLOCKLIST_TRUSTED_GROUPS=

# DATABASE_URL is deliberately NOT here: docker-compose.yml hard-wires it to the
# bundled postgres service, so a dev container cannot be pointed at production
# by editing an env file.
